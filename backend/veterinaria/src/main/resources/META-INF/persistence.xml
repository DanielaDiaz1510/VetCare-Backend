<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <!-- Define Persistence Unit -->
  <persistence-unit name="VeterinariaPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.mycompany.veterinaria.model.entity.Alergia</class>
    <class>com.mycompany.veterinaria.model.entity.Auditoria</class>
    <class>com.mycompany.veterinaria.model.entity.Cita</class>
    <class>com.mycompany.veterinaria.model.entity.HistorialClinico</class>
    <class>com.mycompany.veterinaria.model.entity.Mascota</class>
    <class>com.mycompany.veterinaria.model.entity.MascotaAlergia</class>
    <class>com.mycompany.veterinaria.model.entity.Medicamento</class>
    <class>com.mycompany.veterinaria.model.entity.Propietario</class>
    <class>com.mycompany.veterinaria.model.entity.Tratamiento</class>
    <class>com.mycompany.veterinaria.model.entity.Vacuna</class>
    <class>com.mycompany.veterinaria.model.entity.Vacunacion</class>
    <class>com.mycompany.veterinaria.model.entity.Veterinario</class>
    
    <!-- ENTIDADES DE SEGURIDAD (Vistas en pasos anteriores) -->
    <class>com.mycompany.veterinaria.model.entity.Usuario</class>
    <class>com.mycompany.veterinaria.model.entity.Rol</class>
    <class>com.mycompany.veterinaria.model.entity.UsuarioRol</class>
    
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    
    <properties>
     <!-- CONEXIÓN BD -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/veterinaria?zeroDateTimeBehavior=CONVERT_TO_NULL&amp;createDatabaseIfNotExist=true"/>
      <property name="jakarta.persistence.jdbc.user" value="root"/>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.password" value=""/>
      
      <!-- HIBERNATE -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
      
      <!-- MANEJO DEL ESQUEMA -->
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      
      <!-- LOGGING -->
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
